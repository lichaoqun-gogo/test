# 依赖目录
frontend/node_modules/
backend/node_modules/

# 编译产物
# 注意：frontend/dist、backend/bin、backend/server 有意保留提交（便于交付方直接运行），不忽略；
# 以下忽略的是"本地临时/平台特定"产物
backend/server-linux
backend/osm_mngt.db

# 日志文件
backend/logs/
*.log

# IDE 配置
.idea/
.vscode/
.trae/
*.swp
*.swo
.DS_Store

# 环境变量文件
.env
.env.local
.env.*.local

# 编译缓存
frontend/.vite/
frontend/node_modules/.vite/

# 二进制文件
*.exe
*.dll
*.so
*.dylib

# Node.js 相关（误留的）
backend/package.json
backend/package-lock.json

# 数据库文件
*.db
*.sqlite
*.sqlite3

# Go 相关
backend/vendor/

# 临时文件
*.tmp
*.bak
*.bak.*
